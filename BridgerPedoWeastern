function PlayerEsp.Add(Player)
    if Player == LocalPlayer or PlayerEsp.Entries[Player] then
        return
    end

    PlayerEsp.Entries[Player] = {
        Character = nil,
        Root = nil,
        Humanoid = nil,
        StreakObj = nil,
        StreakAt = 0,
        Streak = nil,
        Text = nil,
        TextShown = false,
        TextColor = nil,
        Label = "",
        LabelDirty = false,
        Dist = -1,
        Version = -1,
        Bars = nil,
        BarShown = nil,
        HealthKey = -1,
        Box = nil,
        BoxOutline = nil,
        BoxShown = false,
        Wake = 0,
    }
end

function PlayerEsp.FreeText(Entry)
    local Text = Entry.Text

    if Text then
        Utils.ReleaseText(Text)
        Entry.Text = nil
        Entry.TextShown = false
        Entry.TextColor = nil
        Entry.Label = ""
        Entry.Dist = -1
        Entry.Version = -1
    end
end

function PlayerEsp.FreeBars(Entry)
    local Bars = Entry.Bars

    if Bars then
        for Index = 1, #Bars do
            Utils.ReleaseSquare(Bars[Index])
        end

        Entry.Bars = nil
        Entry.BarShown = nil
        Entry.HealthKey = -1
    end
end

function PlayerEsp.FreeBox(Entry)
    if Entry.Box then
        Utils.Remove(Entry.Box)
        Entry.Box = nil
    end

    if Entry.BoxOutline then
        Utils.Remove(Entry.BoxOutline)
        Entry.BoxOutline = nil
    end

    Entry.BoxShown = false
end

function PlayerEsp.Free(Entry)
    PlayerEsp.FreeText(Entry)
    PlayerEsp.FreeBars(Entry)
    PlayerEsp.FreeBox(Entry)
end

function PlayerEsp.RemovePlayer(Player)
    local Entry = PlayerEsp.Entries[Player]

    if Entry then
        PlayerEsp.Free(Entry)
        PlayerEsp.Entries[Player] = nil
    end
end

function PlayerEsp.Hide(Entry)
    if Entry.TextShown then
        Entry.Text.Visible = false
        Entry.TextShown = false
    end

    if Entry.BoxShown then
        if Entry.Box then
            Entry.Box.Visible = false
        end

        if Entry.BoxOutline then
            Entry.BoxOutline.Visible = false
        end

        Entry.BoxShown = false
    end

    local Shown = Entry.BarShown

    if Shown then
        local Bars = Entry.Bars

        for Index = 1, #Bars do
            if Shown[Index] then
                Bars[Index].Visible = false
                Shown[Index] = false
            end
        end
    end
end

function PlayerEsp.SetEnabled(Value)
    PlayerEsp.Enabled = Value

    if not Value then
        for _, Entry in pairs(PlayerEsp.Entries) do
            PlayerEsp.Free(Entry)
            Entry.Wake = 0
        end
    end
end

function PlayerEsp.Bump()
    PlayerEsp.Version += 1
end

function PlayerEsp.EnsureBars(Entry)
    if Entry.Bars then
        return true
    end

    local Bars = {}
    local Shown = {}

    for Index = 1, PlayerEsp.Segments do
        local Bar = Utils.AcquireSquare(Color3.fromRGB(0, 255, 0))

        if not Bar then
            for Made = 1, #Bars do
                Utils.ReleaseSquare(Bars[Made])
            end

            return false
        end

        Bars[Index] = Bar
        Shown[Index] = false
    end

    Entry.Bars = Bars
    Entry.BarShown = Shown
    Entry.HealthKey = -1

    return true
end

function PlayerEsp.Bind(Entry, Character)
    Entry.Character = Character
    Entry.Root = Character and Character:FindFirstChild("HumanoidRootPart") or nil
    Entry.Humanoid = Character and Character:FindFirstChildOfClass("Humanoid") or nil
end

function PlayerEsp.GetStreak(Player, Entry, Now)
    local Object = Entry.StreakObj

    if not Object or not Object.Parent then
        if Now < Entry.StreakAt then
            return nil
        end

        Entry.StreakAt = Now + 1

        local Stats = Player:FindFirstChild("leaderstats")
        local Streak = Stats and Stats:FindFirstChild("STREAK")

        Object = Streak and Streak:IsA("ValueBase") and Streak or nil
        Entry.StreakObj = Object
    end

    if Object then
        return Object.Value
    end

    return nil
end

function PlayerEsp.BuildLabel(Name, Dist, Streak)
    local Label = ""

    if PlayerEsp.ShowName then
        Label = Name
    end

    if PlayerEsp.ShowDistance then
        local Part = "[" .. Dist .. " studs]"
        Label = Label == "" and Part or (Label .. " " .. Part)
    end

    if PlayerEsp.ShowStreak and Streak ~= nil then
        local Part = "[Streak: " .. tostring(Streak) .. "]"
        Label = Label == "" and Part or (Label .. " " .. Part)
    end

    return Label
end

function PlayerEsp.Step(Camera, Origin, Now, Player, Entry)
    local Character = Player.Character
    local Root = Entry.Root

    if Character ~= Entry.Character or not Root or not Root.Parent then
        PlayerEsp.Bind(Entry, Character)
        Root = Entry.Root
    end

    if not Root then
        PlayerEsp.Hide(Entry)
        Entry.Wake = Now + 0.25
        return
    end

    local Position = Root.Position
    local Distance = (Origin - Position).Magnitude

    if Distance > PlayerEsp.MaxDistance then
        PlayerEsp.Free(Entry)
        Entry.Wake = Now + 0.5
        return
    end

    local Top, TopOn = Camera:WorldToViewportPoint(Position + Vector3.new(0, PlayerEsp.Up, 0))
    local Bottom, BottomOn = Camera:WorldToViewportPoint(Position - Vector3.new(0, PlayerEsp.Down, 0))
    local PixelHeight = Bottom.Y - Top.Y

    if Top.Z <= 0 or Bottom.Z <= 0 or PixelHeight <= 0 or not (TopOn or BottomOn) then
        PlayerEsp.Hide(Entry)
        return
    end

    local BoxWidth = PixelHeight * PlayerEsp.BoxRatio
    local IsVampire = PlayerEsp.HighlightVampire and Character:GetAttribute("Vampire") == true

    if PlayerEsp.ShowBox then
        if not Entry.Box or not Entry.BoxOutline then
            PlayerEsp.FreeBox(Entry)

            Entry.BoxOutline = Utils.NewBox(Color3.new(0, 0, 0), PlayerEsp.BoxThickness + 2, 1)
            Entry.Box = Utils.NewBox(PlayerEsp.BoxColor, PlayerEsp.BoxThickness, 2)

            if not Entry.Box or not Entry.BoxOutline then
                PlayerEsp.FreeBox(Entry)
            end
        end

        local Box = Entry.Box
        local Outline = Entry.BoxOutline

        if Box and Outline then
            local BoxPosition = Vector2.new(Top.X - BoxWidth / 2, Top.Y)
            local BoxSize = Vector2.new(BoxWidth, PixelHeight)

            Box.Position = BoxPosition
            Box.Size = BoxSize
            Box.Color = IsVampire and PlayerEsp.VampireColor or PlayerEsp.BoxColor
            Box.Thickness = PlayerEsp.BoxThickness

            Outline.Position = BoxPosition
            Outline.Size = BoxSize
            Outline.Thickness = PlayerEsp.BoxThickness + 2

            if not Entry.BoxShown then
                Box.Visible = true
                Outline.Visible = true
                Entry.BoxShown = true
            end
        end
    elseif Entry.Box or Entry.BoxOutline then
        PlayerEsp.FreeBox(Entry)
    end

    local Streak = PlayerEsp.ShowStreak and PlayerEsp.GetStreak(Player, Entry, Now) or nil
    local Dist = math.floor(Distance)

    if Entry.Dist ~= Dist or Entry.Streak ~= Streak or Entry.Version ~= PlayerEsp.Version then
        Entry.Dist = Dist
        Entry.Streak = Streak
        Entry.Version = PlayerEsp.Version
        Entry.Label = PlayerEsp.BuildLabel(Player.Name, Dist, Streak)
        Entry.LabelDirty = true
    end

    if Entry.Label ~= "" then
        local Text = Entry.Text

        if not Text then
            Text = Utils.AcquireText(PlayerEsp.Color)
            Entry.Text = Text
            Entry.TextColor = nil
            Entry.LabelDirty = true
        end

        if Text then
            if Entry.LabelDirty then
                Text.Text = Entry.Label
                Entry.LabelDirty = false
            end

            local Color = IsVampire and PlayerEsp.VampireColor or PlayerEsp.Color

            if Entry.TextColor ~= Color then
                Text.Color = Color
                Entry.TextColor = Color
            end

            Text.Position = Vector2.new(Top.X, Top.Y - 18)

            if not Entry.TextShown then
                Text.Visible = true
                Entry.TextShown = true
            end
        end
    elseif Entry.TextShown then
        Entry.Text.Visible = false
        Entry.TextShown = false
    end

    if PlayerEsp.ShowHealth then
        local Humanoid = Entry.Humanoid

        if not Humanoid or not Humanoid.Parent then
            Humanoid = Character:FindFirstChildOfClass("Humanoid")
            Entry.Humanoid = Humanoid
        end

        local Ratio = 0

        if Humanoid then
            local MaxHealth = Humanoid.MaxHealth

            if MaxHealth > 0 then
                Ratio = math.clamp(Humanoid.Health / MaxHealth, 0, 1)
            end
        end

        if PlayerEsp.EnsureBars(Entry) then
            local Segments = PlayerEsp.Segments
            local Gap = PixelHeight > 30 and PlayerEsp.BarGap or 0
            local SegmentHeight = (PixelHeight - Gap * (Segments - 1)) / Segments
            local Thickness = PlayerEsp.BarThickness
            local X = Top.X - BoxWidth / 2 - Thickness - 4
            local Key = math.floor(Ratio * 50)
            local Recolor = Entry.HealthKey ~= Key
            local Color = nil

            if Recolor then
                Entry.HealthKey = Key
                Color = Color3.fromHSV(Ratio * 0.33, 1, 1)
            end

            local Bars = Entry.Bars
            local Shown = Entry.BarShown

            for Index = 1, Segments do
                local Bar = Bars[Index]
                local Fill = math.clamp(Ratio * Segments - (Index - 1), 0, 1)

                if Fill > 0 then
                    local Height = math.max(SegmentHeight * Fill, 1)
                    local Base = Bottom.Y - (Index - 1) * (SegmentHeight + Gap)

                    Bar.Size = Vector2.new(Thickness, Height)
                    Bar.Position = Vector2.new(X, Base - Height)

                    if Recolor then
                        Bar.Color = Color
                    end

                    if not Shown[Index] then
                        Bar.Visible = true
                        Shown[Index] = true
                    end
                elseif Shown[Index] then
                    Bar.Visible = false
                    Shown[Index] = false
                end
            end
        else
            Entry.Wake = Now + 1
        end
    elseif Entry.Bars then
        PlayerEsp.FreeBars(Entry)
    end
end

function PlayerEsp.Update(Camera, Origin, Now)
    if not PlayerEsp.Enabled then return end

    for Player, Entry in pairs(PlayerEsp.Entries) do
        if Now >= Entry.Wake then
            PlayerEsp.Step(Camera, Origin, Now, Player, Entry)
        end
    end
end

