function Horses.Restore()
    local Horse = Horses.Horse

    if Horse and Horse.Parent and Horses.Original ~= nil then
        pcall(function()
            Horse:SetAttribute("Stat_Speed", Horses.Original)
        end)
    end

    Horses.Original = nil
end

function Horses.Select(Horse)
    if Horse == Horses.Horse then return end

    Horses.Restore()
    Horses.Horse = Horse

    if Horse then
        Utils.Notify("Horse found: " .. Horse.Name)
    end
end

function Horses.Apply()
    local Horse = Horses.Horse

    if not Horse or not Horse.Parent then return end

    local Current = Horse:GetAttribute("Stat_Speed")

    if Current == nil then return end

    if Horses.Original == nil then
        Horses.Original = Current
    end

    if Current ~= Horses.Speed then
        Horse:SetAttribute("Stat_Speed", Horses.Speed)
    end
end

function Horses.Update()
    if not Horses.Enabled then return end

    local Now = os.clock()
    local Horse = Horses.Horse

    if (not Horse or not Horse.Parent) and Now - Horses.LastScan >= Horses.ScanRate then
        Horses.LastScan = Now
        Horses.Horse = nil
        Horses.Original = nil
        Horses.Select(Horses.Find())
    end

    Horses.Apply()
end

