    end

    return not Utils.HasNearbyPlayer(Position, Safes.PlayerDistance)
end

function Safes.SameList(List)
    local Current = Safes.Current

    if #List ~= #Current then
        return false
    end

    for Index = 1, #List do
        if List[Index] ~= Current[Index] then
            return false
        end
    end

    return true
end

function Safes.Refresh()
    local Folder = Safes.GetFolder()
    local List = {}

    if Folder then
        for _, Safe in ipairs(Folder:GetChildren()) do
            if Utils.IsTarget(Safe) and Safes.IsAvailable(Safe) then
                table.insert(List, Safe)
            end
        end
    end

    if Safes.SameList(List) then
        return
    end

    local Values = {}
    local Map = {}
    local SelectedLabel = nil

    for Index, Safe in ipairs(List) do
        local Label = "Safe #" .. Index

        Map[Label] = Safe
        table.insert(Values, Label)

        if Safe == Safes.Selected then
            SelectedLabel = Label
        end
    end

    Safes.Current = List
    Safes.Map = Map

    pcall(function()
        Meow.Options.TPSafeDropdown:SetValues(Values)
    end)

    if not SelectedLabel and #Values > 0 then
        SelectedLabel = Values[1]
    end

    Safes.Selected = SelectedLabel and Map[SelectedLabel] or nil

    if SelectedLabel then
        pcall(function()
            Meow.Options.TPSafeDropdown:SetValue(SelectedLabel)
        end)
    end
end

function Safes.Schedule()
    if Safes.Pending then return end

    Safes.Pending = true

    task.delay(0.15, function()
        Safes.Pending = false
        Safes.Refresh()
    end)
end

function Safes.Start()
    Safes.StartId += 1
    local Id = Safes.StartId

    task.spawn(function()
        local Folder = Safes.GetFolder()

        while not Folder do
            task.wait(1)

            if Id ~= Safes.StartId then return end

            Folder = Safes.GetFolder()
        end

        if Id ~= Safes.StartId then return end

        Safes.Added = Folder.ChildAdded:Connect(Safes.Schedule)
        Safes.Removed = Folder.ChildRemoved:Connect(Safes.Schedule)

        while Id == Safes.StartId do
            Safes.Refresh()
            task.wait(Safes.RefreshRate)
        end
    end)
end

function Safes.Stop()
    Safes.StartId += 1

    if Safes.Added then
        Safes.Added:Disconnect()
        Safes.Added = nil
    end

    if Safes.Removed then
        Safes.Removed:Disconnect()
        Safes.Removed = nil
    end
end

function Safes.TeleportTo(Safe)
    if not Safe or not Safe.Parent then
        Utils.Notify("Safe indisponível.")
        Safes.Refresh()
        return
    end

    local SafeCFrame = Utils.GetCFrame(Safe)

    if not SafeCFrame then
        Utils.Notify("Não foi possível localizar o Safe.")
        return
    end

    if Utils.HasNearbyPlayer(SafeCFrame.Position, Safes.PlayerDistance) then
        Utils.Notify("Há um player a menos de " .. Safes.PlayerDistance .. " studs desse Safe.")
        Safes.Refresh()
        return
    end

    local HorseRoot = ChestFarm.GetHorseRoot()

    if not HorseRoot then
        Utils.Notify("Seu cavalo não foi encontrado. Monte no cavalo primeiro.")
        return
    end

    local Success = pcall(function()
        HorseRoot.CFrame = CFrame.new(SafeCFrame.Position + Vector3.new(0, 5, 0))
        HorseRoot.AssemblyLinearVelocity = Vector3.zero
        HorseRoot.AssemblyAngularVelocity = Vector3.zero
    end)

    Utils.Notify(Success and "Cavalo teleportado para o Safe." or "Não foi possível teleportar o cavalo.")
end

function Safes.Teleport()
    Safes.TeleportTo(Safes.Selected)
end

function Safes.TeleportNearest()
    local HorseRoot = ChestFarm.GetHorseRoot()

    if not HorseRoot then
        Utils.Notify("Seu cavalo não foi encontrado. Monte no cavalo primeiro.")
        return
    end

    local Folder = Safes.GetFolder()
    local Best = nil
    local BestDistance = math.huge

    if Folder then
        for _, Safe in ipairs(Folder:GetChildren()) do
            local Position = Utils.GetPosition(Safe)

            if Position and not Utils.HasNearbyPlayer(Position, Safes.PlayerDistance) then
                local Distance = (HorseRoot.Position - Position).Magnitude

                if Distance < BestDistance then
                    BestDistance = Distance
                    Best = Safe
                end
            end
        end
    end

    if not Best then
        Utils.Notify("Nenhum Safe disponível.")
        return
    end

    Safes.TeleportTo(Best)
end

function ChestFarm.Track(Instance)
    if Instance.Name == "ChestBox" and Instance:IsA("Model") and not ChestFarm.Set[Instance] then
        ChestFarm.Set[Instance] = true
        table.insert(ChestFarm.List, Instance)
    end
end

function ChestFarm.Untrack(Instance)
    if ChestFarm.Set[Instance] then
        ChestFarm.Set[Instance] = nil
        ChestFarm.Prompts[Instance] = nil
        ChestFarm.PromptAt[Instance] = nil

        local Index = table.find(ChestFarm.List, Instance)

        if Index then
            table.remove(ChestFarm.List, Index)
        end
    end
end

function ChestFarm.Detach()
    if ChestFarm.Added then
        ChestFarm.Added:Disconnect()
        ChestFarm.Added = nil
    end

    if ChestFarm.Removed then
        ChestFarm.Removed:Disconnect()
        ChestFarm.Removed = nil
    end

    ChestFarm.Folder = nil
    ChestFarm.List = {}
    ChestFarm.Set = {}
    ChestFarm.Prompts = {}
    ChestFarm.PromptAt = {}
end

function ChestFarm.Attach()
    local Chests = Workspace:FindFirstChild("Chests")

    if Chests == ChestFarm.Folder then return end

    ChestFarm.Detach()
    ChestFarm.Folder = Chests

    if not Chests then return end

    ChestFarm.Added = Chests.DescendantAdded:Connect(ChestFarm.Track)
    ChestFarm.Removed = Chests.DescendantRemoving:Connect(ChestFarm.Untrack)

    for _, Descendant in ipairs(Chests:GetDescendants()) do
        ChestFarm.Track(Descendant)
    end
end

function ChestFarm.GetPrompt(Chest)
    local Cached = ChestFarm.Prompts[Chest]

    if Cached and Cached.Parent then
        return Cached
    end

    local Now = os.clock()
    local Last = ChestFarm.PromptAt[Chest]

    if Last and Now - Last < 1 then
        return nil
    end

    ChestFarm.PromptAt[Chest] = Now
    ChestFarm.Prompts[Chest] = nil

    for _, Object in ipairs(Chest:GetDescendants()) do
        if Object:IsA("ProximityPrompt") then
            ChestFarm.Prompts[Chest] = Object
            return Object
        end
    end

    return nil
end

function ChestFarm.GetValidChest()
    for _, Chest in ipairs(ChestFarm.List) do
        if Chest.Parent then
            local Prompt = ChestFarm.GetPrompt(Chest)

            if Prompt and Prompt.Enabled then
                local Position = Utils.GetPosition(Chest)

                if Position and not Utils.HasNearbyPlayer(Position, ChestFarm.PlayerDistance) then
                    return Chest, Prompt, Position
                end
            end
        end
    end

    return nil
end

function ChestFarm.CanTeleport(Root, Destination)
    if not Root or not Root.Parent then
        return false
    end

    local Distance = ChestFarm.PlayerDistance

    if Utils.HasNearbyPlayer(Root.Position, Distance) then
        return false
    end

    if Destination and Utils.HasNearbyPlayer(Destination, Distance) then
        return false
    end

    return true
end

function ChestFarm.ClearIdle()
    ChestFarm.IdleCFrame = nil
    ChestFarm.IdleRoot = nil
end

function ChestFarm.SetIdle(Root)
    if ChestFarm.IdleRoot == Root and ChestFarm.IdleCFrame then
        return
    end

    if not ChestFarm.CanTeleport(Root, ChestFarm.IdleTarget.Position) then
        return
    end

    ChestFarm.IdleRoot = Root
    ChestFarm.IdleCFrame = ChestFarm.IdleTarget

    pcall(function()
        Root.CFrame = ChestFarm.IdleCFrame
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end)
end

function ChestFarm.Run(Id)
    while ChestFarm.Enabled and Id == ChestFarm.RunId do
        ChestFarm.Attach()

        local Root = ChestFarm.GetHorseRoot()

        if not Root then
            ChestFarm.ClearIdle()
            task.wait(0.25)
            continue
        end

        local Chest, Prompt, Position = ChestFarm.GetValidChest()

        if not Chest or not Prompt or not Position then
            ChestFarm.SetIdle(Root)
            task.wait(0.1)
            continue
        end

        if not ChestFarm.CanTeleport(Root, Position) then
            task.wait(0.25)
            continue
        end

        ChestFarm.ClearIdle()

        if not ChestFarm.Enabled or Id ~= ChestFarm.RunId then
            break
        end

        Root = ChestFarm.GetHorseRoot()

        if not Root then
            task.wait(0.25)
            continue
        end

        if not ChestFarm.CanTeleport(Root, Position) then
            task.wait(0.25)
            continue
        end

        pcall(function()
            Root.CFrame = CFrame.new(Position + Vector3.new(0, 3, 0))
            Root.AssemblyLinearVelocity = Vector3.zero
            Root.AssemblyAngularVelocity = Vector3.zero
        end)

        local StartTime = os.clock()

        while ChestFarm.Enabled and Id == ChestFarm.RunId and os.clock() - StartTime < ChestFarm.Cooldown do
            task.wait(0.05)

            if not ChestFarm.GetHorseRoot() then
                break
            end

            if not Chest.Parent or not Prompt.Parent or not Prompt.Enabled then
                break
            end
        end

        if not ChestFarm.Enabled or Id ~= ChestFarm.RunId then
            break
        end

        if Chest.Parent and Prompt.Parent and Prompt.Enabled then
            pcall(function()
                fireproximityprompt(Prompt)
            end)
        end

        task.wait(0.15)
    end

    ChestFarm.ClearIdle()
end

function ChestFarm.SetEnabled(Value)
    ChestFarm.Enabled = Value
    ChestFarm.RunId += 1
    ChestFarm.ClearIdle()

    if Value then
        local Id = ChestFarm.RunId
        task.spawn(ChestFarm.Run, Id)
    else
        ChestFarm.Detach()
    end
end

local BetterAim = {
    Enabled = false,
    Smooth = 10,
    Cone = 25,
    MoveCone = 8,
    TwistRatio = 0.5,
    MaxTwist = math.rad(35),
    MaxLead = math.rad(15),
    MaxHeadYaw = math.rad(70),
    MaxHeadPitch = math.rad(60),
    BodyYaw = nil,
    LastCamYaw = nil,
    Twisted = 0,
    HeadYaw = 0,
    HeadPitch = 0,
    AlignCFrame = nil,
    RootC0 = nil,
    NeckC0 = nil,
    Character = nil,
    Joints = {},
    Connection = nil,
}

function BetterAim.Wrap(Angle)
    return (Angle + math.pi) % (math.pi * 2) - math.pi
end

function BetterAim.Restore()
    for _, Data in pairs(BetterAim.Joints) do
        if Data.Joint and Data.Joint.Parent then
            pcall(function()
                Data.Joint.C0 = Data.Base
            end)
        end
    end

    BetterAim.BodyYaw = nil
    BetterAim.LastCamYaw = nil
    BetterAim.Twisted = 0
    BetterAim.HeadYaw = 0
    BetterAim.HeadPitch = 0
    BetterAim.AlignCFrame = nil
    BetterAim.RootC0 = nil
    BetterAim.NeckC0 = nil
end

function BetterAim.LoadJoints(Character, Root)
    if BetterAim.Character == Character then return end

    BetterAim.Restore()
    BetterAim.Character = Character
    BetterAim.Joints = {}

    local Torso = Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso")
    local RootJoint = Root:FindFirstChild("RootJoint")
    local Neck = Torso and Torso:FindFirstChild("Neck")

    if RootJoint and RootJoint:IsA("Motor6D") then
        local Base = RootJoint.C0

        BetterAim.Joints.Root = {
            Joint = RootJoint,
            Base = Base,
            Pivot = Base.Position,
            Rotation = Base - Base.Position,
        }
    end

    if Neck and Neck:IsA("Motor6D") then
        local Base = Neck.C0

        BetterAim.Joints.Neck = {
            Joint = Neck,
            Base = Base,
            Pivot = Base.Position,
            Rotation = Base - Base.Position,
        }
    end
end

function BetterAim.IsBlocked(Character)
    return Character:GetAttribute("IsRiding")
        or Character:GetAttribute("IsRagdolled")
        or Character:GetAttribute("IsKnockedDown")
        or Character:GetAttribute("WallstickActive") == true
        or typeof(Character:GetAttribute("FreezeGrabOrientation")) == "CFrame"
end

function BetterAim.ApplyJoints()
    local RootData = BetterAim.Joints.Root
    local NeckData = BetterAim.Joints.Neck

    if RootData and RootData.Joint.Parent and BetterAim.RootC0 then
        RootData.Joint.C0 = BetterAim.RootC0
    end

    if NeckData and NeckData.Joint.Parent and BetterAim.NeckC0 then
        NeckData.Joint.C0 = BetterAim.NeckC0
    end
end

function BetterAim.Update(DeltaTime)
    if not BetterAim.Enabled then return end

    local Character = LocalPlayer.Character
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local CurrentCamera = Workspace.CurrentCamera
    local Align = Root and Root:FindFirstChild("AimAlignOrientation")

    if not (Character and Root and Humanoid and CurrentCamera) then return end

    if not Align or not Align.Enabled or BetterAim.IsBlocked(Character) then
        if BetterAim.BodyYaw then
            BetterAim.Restore()
        end

        return
    end

    BetterAim.LoadJoints(Character, Root)

    local Delta = math.clamp(DeltaTime, 1 / 240, 0.1)
    local Look = CurrentCamera.CFrame.LookVector
    local CamYaw = math.atan2(-Look.X, -Look.Z)
    local CamPitch = math.asin(math.clamp(Look.Y, -1, 1))

    local YawRate = BetterAim.LastCamYaw and BetterAim.Wrap(CamYaw - BetterAim.LastCamYaw) / Delta or 0
    BetterAim.LastCamYaw = CamYaw

    if not BetterAim.BodyYaw then
        local RootLook = Root.CFrame.LookVector
        BetterAim.BodyYaw = math.atan2(-RootLook.X, -RootLook.Z)
    end

    local Alpha = 1 - math.exp(-BetterAim.Smooth * Delta)
    local FastAlpha = 1 - math.exp(-BetterAim.Smooth * 1.5 * Delta)

    local Moving = Humanoid.MoveDirection.Magnitude > 0.1
    local Cone = math.rad(Moving and BetterAim.MoveCone or BetterAim.Cone)

    local Diff = BetterAim.Wrap(CamYaw - BetterAim.BodyYaw)
    local Target = BetterAim.BodyYaw

    if math.abs(Diff) > Cone then
        Target = CamYaw - (Diff > 0 and 1 or -1) * Cone
    end

    BetterAim.BodyYaw = BetterAim.Wrap(BetterAim.BodyYaw + BetterAim.Wrap(Target - BetterAim.BodyYaw) * Alpha)

    BetterAim.AlignCFrame = CFrame.Angles(0, BetterAim.BodyYaw, 0)
    Align.RigidityEnabled = false
    Align.Responsiveness = 200
    Align.CFrame = BetterAim.AlignCFrame

    local Residual = BetterAim.Wrap(CamYaw - BetterAim.BodyYaw)
    local Lead = math.clamp(YawRate * 0.05, -BetterAim.MaxLead, BetterAim.MaxLead)
    local TwistTarget = math.clamp(Residual * BetterAim.TwistRatio + Lead, -BetterAim.MaxTwist, BetterAim.MaxTwist)

    BetterAim.Twisted += (TwistTarget - BetterAim.Twisted) * FastAlpha

    local HeadYawTarget = math.clamp(Residual - BetterAim.Twisted, -BetterAim.MaxHeadYaw, BetterAim.MaxHeadYaw)
    local HeadPitchTarget = math.clamp(CamPitch, -BetterAim.MaxHeadPitch, BetterAim.MaxHeadPitch)

    BetterAim.HeadYaw += (HeadYawTarget - BetterAim.HeadYaw) * FastAlpha
    BetterAim.HeadPitch += (HeadPitchTarget - BetterAim.HeadPitch) * FastAlpha

    local RootData = BetterAim.Joints.Root

    if RootData then
        BetterAim.RootC0 = CFrame.new(RootData.Pivot)
            * CFrame.Angles(0, BetterAim.Twisted, 0)
            * RootData.Rotation
    end

    local NeckData = BetterAim.Joints.Neck

    if NeckData then
        BetterAim.NeckC0 = CFrame.new(NeckData.Pivot)
            * CFrame.Angles(0, BetterAim.HeadYaw, 0)
            * CFrame.Angles(BetterAim.HeadPitch, 0, 0)
            * NeckData.Rotation
    end

    BetterAim.ApplyJoints()
end

function BetterAim.Reapply()
    if not BetterAim.Enabled or not BetterAim.AlignCFrame then return end

    local Character = LocalPlayer.Character
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    local Align = Root and Root:FindFirstChild("AimAlignOrientation")

    if Align and Align.Enabled then
        Align.RigidityEnabled = false
        Align.Responsiveness = 200
        Align.CFrame = BetterAim.AlignCFrame
    end

    BetterAim.ApplyJoints()
end

function BetterAim.Bind()
    pcall(function()
        RunService:UnbindFromRenderStep("MeowBetterAim")
    end)

    RunService:BindToRenderStep("MeowBetterAim", Enum.RenderPriority.Last.Value, BetterAim.Update)
end

function BetterAim.Unbind()
    pcall(function()
        RunService:UnbindFromRenderStep("MeowBetterAim")
    end)
end

function BetterAim.SetEnabled(Value)
    BetterAim.Enabled = Value

    if Value then
        BetterAim.Bind()
        Utils.Connect(BetterAim, RunService.PreSimulation, BetterAim.Reapply)
    else
        BetterAim.Unbind()
        Utils.Disconnect(BetterAim)
        BetterAim.Restore()
    end
end

local AutoOre = {
    Enabled = false,
    Lead = 0.5,
    Cooldown = 0.25,
    LastClick = 0,
    LastRotation = nil,
    LastOffset = nil,
    LastStart = nil,
    Cursor = nil,
    Perfect = nil,
    Outer = nil,
    Inner = nil,
    NextScan = 0,
    Connection = nil,
}

function AutoOre.Wrap(Angle)
    return Angle % 360
end

function AutoOre.Signed(Angle)
    return (Angle + 180) % 360 - 180
end

function AutoOre.Reset()
    AutoOre.LastRotation = nil
    AutoOre.LastOffset = nil
    AutoOre.LastStart = nil
end

function AutoOre.Scan(Now)
    AutoOre.NextScan = Now + 0.05
    AutoOre.Cursor = nil
    AutoOre.Perfect = nil
    AutoOre.Outer = nil
    AutoOre.Inner = nil

    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local Gui = PlayerGui and PlayerGui:FindFirstChild("SkillCheck")
    local Ring = Gui and Gui:FindFirstChild("Ring")
    local Cursor = Ring and Ring:FindFirstChild("Cursor")
    local Perfect = Ring and Ring:FindFirstChild("PerfectZone")

    if not Cursor or not Perfect then
        return false
    end

    local Outer = Perfect:FindFirstChildOfClass("UIGradient")
    local InnerRing = Perfect:FindFirstChild("Ring")
    local Stroke = InnerRing and InnerRing:FindFirstChildOfClass("UIStroke")
    local Inner = Stroke and Stroke:FindFirstChildOfClass("UIGradient")

    if not Outer or not Inner then
        return false
    end

    AutoOre.Cursor = Cursor
    AutoOre.Perfect = Perfect
    AutoOre.Outer = Outer
    AutoOre.Inner = Inner

    return true
end

function AutoOre.GetParts(Now)
    local Cursor = AutoOre.Cursor
    local Perfect = AutoOre.Perfect

    if not (Cursor and Perfect and Cursor.Parent and Perfect.Parent and AutoOre.Outer.Parent and AutoOre.Inner.Parent) then
        if Now < AutoOre.NextScan or not AutoOre.Scan(Now) then
            return nil
        end

        Cursor = AutoOre.Cursor
        Perfect = AutoOre.Perfect
    end

    if not Perfect.Visible then
        return nil
    end

    return Cursor, AutoOre.Outer, AutoOre.Inner
end

function AutoOre.Click()
    local Now = os.clock()

    if Now - AutoOre.LastClick < AutoOre.Cooldown then return end

    AutoOre.LastClick = Now

    if mouse1click then
        pcall(mouse1click)
    end
end

function AutoOre.Update()
    if not AutoOre.Enabled then return end

    local Cursor, Outer, Inner = AutoOre.GetParts(os.clock())

    if not Cursor then
        AutoOre.Reset()
        return
    end

    local Start = AutoOre.Wrap(Inner.Rotation - 180)
    local Size = AutoOre.Wrap(Outer.Rotation - Start)

    if Size <= 0 then return end

    if AutoOre.LastStart and math.abs(AutoOre.Signed(Start - AutoOre.LastStart)) > 0.01 then
        AutoOre.LastRotation = nil
        AutoOre.LastOffset = nil
    end

    AutoOre.LastStart = Start

    local Current = AutoOre.Wrap(Cursor.Rotation)

    if not AutoOre.LastRotation then
        AutoOre.LastRotation = Current
        return
    end

    local Delta = AutoOre.Signed(Current - AutoOre.LastRotation)
    AutoOre.LastRotation = Current

    local Predicted = Current + Delta * AutoOre.Lead
    local Center = Start + Size / 2
    local Offset = AutoOre.Signed(Predicted - Center)
    local Previous = AutoOre.LastOffset

    AutoOre.LastOffset = Offset

    if not Previous or math.abs(Offset) > 45 or math.abs(Previous) > 45 then return end

    local CrossedForward = Delta > 0 and Previous <= 0 and Offset > 0
    local CrossedBackward = Delta < 0 and Previous >= 0 and Offset < 0

    if CrossedForward or CrossedBackward then
        AutoOre.Click()
    end
end

function AutoOre.SetEnabled(Value)
    if Value and not mouse1click then
        Utils.Notify("mouse1click is not supported by your executor.")

        task.defer(function()
            pcall(function()
                Meow.Toggles.AutoOreToggle:SetValue(false)
            end)
        end)

        return
    end

    AutoOre.Enabled = Value
    AutoOre.Reset()

    if Value then
        Utils.Connect(AutoOre, RunService.RenderStepped, AutoOre.Update)
    else
        Utils.Disconnect(AutoOre)
    end
end

