function Combat.CreateFOV()
    if Combat.Circle then return end

    local Success, Circle = pcall(function()
        local C = Drawing.new("Circle")
        C.Thickness = 1.5
        C.NumSides = 64
        C.Radius = Combat.FOV
        C.Filled = false
        C.Color = Color3.fromRGB(255, 80, 80)
        C.Transparency = 0.6
        C.Visible = false
        return C
    end)

    if Success then
        Combat.Circle = Circle
    end
end

function Combat.UpdateFOV(CurrentCamera)
    local Circle = Combat.Circle

    if not Circle then return end

    local Size = CurrentCamera.ViewportSize
    Circle.Position = Vector2.new(Size.X / 2, Size.Y / 2)
    Circle.Radius = Combat.FOV
    Circle.Visible = true
end

