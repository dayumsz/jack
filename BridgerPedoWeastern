function AutoFish.FireNearbyPrompts()
    local Root = Utils.GetRoot()
    if not Root then return end

    local Now = os.clock()
    if Now - AutoFish.LastProximityFire < AutoFish.ProximityCooldown then return end

    local Origin = Root.Position
    local Radius = AutoFish.ProximityRadius

    local OverlapParams = OverlapParams.new()
    OverlapParams.FilterType = Enum.RaycastFilterType.Exclude
    OverlapParams.FilterDescendantsInstances = { LocalPlayer.Character or {} }

    local Parts = Workspace:GetPartBoundsInRadius(Origin, Radius, OverlapParams)

    local Best = nil
    local BestDist = math.huge

    for _, Part in ipairs(Parts) do
        local Prompt = Part:FindFirstChildOfClass("ProximityPrompt")
            or Part.Parent and Part.Parent:FindFirstChildOfClass("ProximityPrompt")
        if Prompt and Prompt.Enabled then
            local Dist = (Origin - Part.Position).Magnitude
            if Dist < BestDist then
                BestDist = Dist
                Best = Prompt
            end
        end
    end

    if Best then
        AutoFish.LastProximityFire = Now
        pcall(fireproximityprompt, Best)
    end
end

function AutoFish.GetRemote()
    if AutoFish.Remote and AutoFish.Remote.Parent then
        return AutoFish.Remote
    end

    local Framework = ReplicatedStorage:FindFirstChild("WesternFramework")
    local Shared = Framework and Framework:FindFirstChild("Shared")
    local Remotes = Shared and Shared:FindFirstChild("Remotes")

    AutoFish.Remote = Remotes and Remotes:FindFirstChild("FishingEvent") or nil

    return AutoFish.Remote
end

function AutoFish.GetQte()
    if AutoFish.Qte then
        return AutoFish.Qte
    end

    local Modules = ReplicatedStorage:FindFirstChild("Modules")
    local Script = Modules and Modules:FindFirstChild("FishingQTE")

    if not Script then
        return nil
    end

    local Success, Result = pcall(require, Script)

    if Success and type(Result) == "table" then
        AutoFish.Qte = Result
    end

    return AutoFish.Qte
end

function AutoFish.GetGui(...)
