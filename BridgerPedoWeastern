function HorseFly.Attach(Root)
    HorseFly.Destroy()

    local Velocity = Instance.new("BodyVelocity")
    Velocity.Name = "MeowHorseFly"
    Velocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    Velocity.Velocity = Vector3.zero
    Velocity.Parent = Root

    HorseFly.Velocity = Velocity
    HorseFly.Root = Root
end

function HorseFly.GetDirection()
    local CurrentCamera = Workspace.CurrentCamera
    local Input = Services.UserInputService

    if not CurrentCamera or Input:GetFocusedTextBox() then
        return Vector3.zero
    end

    local Look = CurrentCamera.CFrame.LookVector
    local Right = CurrentCamera.CFrame.RightVector
    local Direction = Vector3.zero

    if Input:IsKeyDown(Enum.KeyCode.W) then
        Direction += Look
    end

    if Input:IsKeyDown(Enum.KeyCode.S) then
        Direction -= Look
    end

    if Input:IsKeyDown(Enum.KeyCode.D) then
        Direction += Right
    end

    if Input:IsKeyDown(Enum.KeyCode.A) then
        Direction -= Right
    end

    if Input:IsKeyDown(Enum.KeyCode.Space) then
        Direction += Vector3.yAxis
    end

    if Input:IsKeyDown(Enum.KeyCode.LeftControl) or Input:IsKeyDown(Enum.KeyCode.LeftShift) then
        Direction -= Vector3.yAxis
    end

    return Direction
end

function HorseFly.Update()
    if not HorseFly.Enabled then return end

    local Root = ChestFarm.GetHorseRoot()

    if not Root then
        HorseFly.Destroy()
        return
    end

    if HorseFly.Root ~= Root or not HorseFly.Velocity or HorseFly.Velocity.Parent ~= Root then
        HorseFly.Attach(Root)
    end

    local Direction = HorseFly.GetDirection()

    HorseFly.Velocity.Velocity = Direction.Magnitude > 0 and Direction.Unit * HorseFly.Speed or Vector3.zero
end

