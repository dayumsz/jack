function Utils.HasNearbyPlayer(Position, Distance)
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            local Character = Player.Character
            local PlayerRoot = Character and Character:FindFirstChild("HumanoidRootPart")

            if PlayerRoot and (PlayerRoot.Position - Position).Magnitude <= Distance then
                return true
            end
        end
    end

    return false
end

local TextEsp = {}
TextEsp.__index = TextEsp

function TextEsp.new(Options)
    return setmetatable({
        Enabled = false,
        MaxDistance = Options.MaxDistance,
        Color = Options.Color,
        Resolve = Options.Resolve,
        Accept = Options.Accept or Utils.IsTarget,
        Deep = Options.Deep == true,
        Title = Options.Title,
        Offset = Vector3.new(0, Options.Offset or 3, 0),
        PosRate = Options.PosRate or 0,
        Cull = Options.Cull or 0.5,
        Entries = {},
        Added = nil,
        Removed = nil,
        StartId = 0,
    }, TextEsp)
end

function TextEsp.Free(Entry)
    local Text = Entry.Text

    if Text then
        Utils.ReleaseText(Text)
        Entry.Text = nil
        Entry.Shown = false
        Entry.Dist = -1
    end
end

function TextEsp:Add(Instance)
    if self.Entries[Instance] or not Instance.Parent or not self.Accept(Instance) then
        return
    end

    self.Entries[Instance] = {
        Text = nil,
        Shown = false,
        Dist = -1,
        Pos = nil,
        PosAt = 0,
        Wake = 0,
    }
end

function TextEsp:Remove(Instance)
    local Entry = self.Entries[Instance]

    if Entry then
        TextEsp.Free(Entry)
        self.Entries[Instance] = nil
    end
end

function TextEsp:Clear()
    for Instance in pairs(self.Entries) do
        self:Remove(Instance)
    end
end

function TextEsp:Start()
    self.StartId += 1
    local Id = self.StartId

    task.spawn(function()
        local Folder = self.Resolve()

        while not Folder do
            task.wait(1)

            if Id ~= self.StartId or not self.Enabled then
                return
            end

            Folder = self.Resolve()
        end

        if Id ~= self.StartId or not self.Enabled then
            return
        end

        if self.Deep then
            self.Added = Folder.DescendantAdded:Connect(function(Instance)
                self:Add(Instance)
            end)

            self.Removed = Folder.DescendantRemoving:Connect(function(Instance)
                self:Remove(Instance)
            end)
        else
            self.Added = Folder.ChildAdded:Connect(function(Instance)
                self:Add(Instance)
            end)

            self.Removed = Folder.ChildRemoved:Connect(function(Instance)
                self:Remove(Instance)
            end)
        end

        local Source = self.Deep and Folder:GetDescendants() or Folder:GetChildren()

        for Index, Instance in ipairs(Source) do
            self:Add(Instance)

            if Index % 1500 == 0 then
                task.wait()

                if Id ~= self.StartId or not self.Enabled then
                    return
                end
            end
        end
    end)
end

function TextEsp:Stop()
    self.StartId += 1

    if self.Added then
        self.Added:Disconnect()
        self.Added = nil
    end

    if self.Removed then
        self.Removed:Disconnect()
        self.Removed = nil
    end

    self:Clear()
end

function TextEsp:SetEnabled(Value)
    self.Enabled = Value

    if Value then
        self:Start()
    else
        self:Stop()
    end
end

function TextEsp:SetColor(Color)
    self.Color = Color

    for _, Entry in pairs(self.Entries) do
        if Entry.Text then
            Entry.Text.Color = Color
        end
    end
end

function TextEsp:Update(Camera, Origin, Now)
    local Max = self.MaxDistance
    local Offset = self.Offset
    local PosRate = self.PosRate
    local Cull = self.Cull
    local Title = self.Title

    for Instance, Entry in pairs(self.Entries) do
        if Now >= Entry.Wake then
            if not Instance.Parent then
                self:Remove(Instance)
            else
                if Now >= Entry.PosAt then
                    Entry.Pos = Utils.GetPosition(Instance)
                    Entry.PosAt = Now + PosRate
                end

                local Position = Entry.Pos
                local Distance = Position and (Origin - Position).Magnitude

                if not Distance or Distance > Max then
                    TextEsp.Free(Entry)
                    Entry.Wake = Now + Cull
                else
                    local Screen, OnScreen = Camera:WorldToViewportPoint(Position + Offset)

                    if OnScreen and Screen.Z > 0 then
                        local Text = Entry.Text

                        if not Text then
                            Text = Utils.AcquireText(self.Color)
                            Entry.Text = Text
                            Entry.Dist = -1
                        end

                        if Text then
                            local Dist = math.floor(Distance)

                            if Entry.Dist ~= Dist then
                                Entry.Dist = Dist
                                Text.Text = (Title or Instance.Name) .. " [" .. Dist .. " studs]"
                            end

                            Text.Position = Vector2.new(Screen.X, Screen.Y)

                            if not Entry.Shown then
                                Text.Visible = true
                                Entry.Shown = true
                            end
                        end
                    elseif Entry.Shown then
                        Entry.Text.Visible = false
                        Entry.Shown = false
                    end
                end
            end
        end
    end
end

