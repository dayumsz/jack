function AutoFish.PressKey(Name)
    if type(Name) ~= "string" or #Name ~= 1 then return end

    if not (keypress and keyrelease) then
        local Now = os.clock()

        if Now - AutoFish.NoKeyNotifyAt > 10 then
            AutoFish.NoKeyNotifyAt = Now
            Utils.Notify("keypress/keyrelease is not supported by your executor.")
        end

        return
    end

    local Code = string.byte(string.upper(Name))

    pcall(keypress, Code)
    task.wait(0.03 + math.random() * 0.04)
    pcall(keyrelease, Code)
end

function AutoFish.IsRod(Tool)
    return Tool:IsA("Tool") and (Tool.Name == "FishingRod" or Tool:GetAttribute("Alias") == "FishingRod")
end

function AutoFish.FindRod()
    local Character = LocalPlayer.Character

    if Character then
        for _, Child in ipairs(Character:GetChildren()) do
            if AutoFish.IsRod(Child) then
                return Child, true
            end
        end
    end

    local Backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

    if Backpack then
        for _, Child in ipairs(Backpack:GetChildren()) do
            if AutoFish.IsRod(Child) then
                return Child, false
            end
        end
    end

    return nil, false
end

function AutoFish.EquipRod()
    local Rod, Equipped = AutoFish.FindRod()

    if Rod and not Equipped then
        local Character = LocalPlayer.Character
        local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

        if Humanoid then
            pcall(function()
                Humanoid:EquipTool(Rod)
            end)
        end
    end

    return Rod, Equipped
end

function AutoFish.Click()
    local Now = os.clock()

    if Now - AutoFish.LastClick < 0.15 then return end

    AutoFish.LastClick = Now

    if mouse1click then
        pcall(mouse1click)
        return
    end

    local Rod, Equipped = AutoFish.FindRod()

    if Rod and Equipped then
        pcall(function()
            Rod:Activate()
        end)
    end
end

function AutoFish.SetPhase(Phase)
    AutoFish.Phase = Phase
    AutoFish.PhaseAt = os.clock()
end

function AutoFish.Reset()
    AutoFish.Id = nil
    AutoFish.Beats = {}
    AutoFish.SetPhase("Idle")
end

function AutoFish.Tap(Data)
    local Qte = AutoFish.GetQte()

    if Qte and Qte.Active() then
        local Success, Result = pcall(Qte.Tap)

        if Success and Result then
            return
        end
    end

    local Remote = AutoFish.GetRemote()

    if Remote then
        pcall(function()
            Remote:FireServer("Tap", Data.Id, Data.Beat, Workspace:GetServerTimeNow())
        end)
    end
end

function AutoFish.ScheduleBeat(Data)
    if not AutoFish.AutoQte then return end

    if type(Data.Target) ~= "number" then return end

    local Key = tostring(Data.Id) .. ":" .. tostring(Data.Beat)

    if AutoFish.Beats[Key] then return end

    AutoFish.Beats[Key] = true

    local RunId = AutoFish.RunId

    task.spawn(function()
        local Target = Data.Target + AutoFish.TapOffset

        while AutoFish.Enabled and RunId == AutoFish.RunId do
            local Remaining = Target - Workspace:GetServerTimeNow()

            if Remaining <= 0 then
                break
            end

            if Remaining > 0.1 then
                task.wait(Remaining - 0.05)
            else
                RunService.Heartbeat:Wait()
            end
        end

        if not AutoFish.Enabled or RunId ~= AutoFish.RunId then return end

        AutoFish.Tap(Data)
    end)
end

function AutoFish.OnEvent(Player, Phase, Data)
    if not AutoFish.Enabled or Player ~= LocalPlayer then return end

    if type(Data) ~= "table" then return end

    if Phase == "Cast" then
        AutoFish.Id = Data.Id
        AutoFish.Beats = {}
        AutoFish.SetPhase("Cast")
        return
    end

    if AutoFish.Id == nil then
        AutoFish.Id = Data.Id
    elseif AutoFish.Id ~= Data.Id then
        return
    end

    if Phase == "Water" then
        AutoFish.SetPhase("Wait")
    elseif Phase == "Bite" then
        AutoFish.SetPhase("Bite")
    elseif Phase == "Reel" then
        AutoFish.SetPhase("Reel")
    elseif Phase == "Beat" then
        if AutoFish.Phase ~= "Qte" then
            AutoFish.SetPhase("Qte")
        end

        AutoFish.ScheduleBeat(Data)
    elseif Phase == "QTEEnd" or Phase == "Reveal" then
        AutoFish.SetPhase("Done")
    elseif Phase == "End" then
        AutoFish.Reset()
    end
end

function AutoFish.RunMash(RunId)
    while AutoFish.Enabled and RunId == AutoFish.RunId and LocalPlayer:GetAttribute("IsMashing") do
        local Label = AutoFish.GetGui("MashingSystem", "Container", "Circle", "KeyLabel")
        local Name = Label and Label.Text

        if Name and AutoFish.MashKeys[Name] then
            AutoFish.PressKey(Name)
        end

        task.wait(AutoFish.MashDelay + math.random() * AutoFish.MashJitter)
    end

    AutoFish.MashActive = false
end

function AutoFish.RunReaction(RunId)
    local Start = os.clock()

    while AutoFish.Enabled and RunId == AutoFish.RunId and LocalPlayer:GetAttribute("IsReacting") and os.clock() - Start < 3 do
        local Circle = AutoFish.GetGui("MashingSystem", "ReactionCircle")
        local Stroke = Circle and Circle:FindFirstChild("UIStroke")
        local Label = Circle and Circle:FindFirstChild("KeyLabel")

        if Circle and Circle.Visible and Stroke and Label then
            local Color = Stroke.Color

            if Color.R > 0.95 and Color.G > 0.95 and Color.B > 0.95 and AutoFish.ReactKeys[Label.Text] then
                task.wait(AutoFish.ReactDelay + math.random() * AutoFish.ReactJitter)
                AutoFish.PressKey(Label.Text)
                break
            end
        end

        RunService.Heartbeat:Wait()
    end

    while AutoFish.Enabled and RunId == AutoFish.RunId and LocalPlayer:GetAttribute("IsReacting") and os.clock() - Start < 3 do
        task.wait(0.05)
    end

    AutoFish.ReactActive = false
end

function AutoFish.ShakeStep()
    if not AutoFish.Enabled or not LocalPlayer:GetAttribute("IsShaking") then
        AutoFish.StopShake()
        return
    end

    local Camera = Workspace.CurrentCamera

    if not Camera then return end

    local Time = os.clock() - AutoFish.ShakeStart
    local Offset = math.sin(Time * math.pi * 2 / AutoFish.ShakePeriod) * math.rad(AutoFish.ShakeAmplitude)
    local Delta = Offset - AutoFish.ShakeOffset

    AutoFish.ShakeOffset = Offset

    local Current = Camera.CFrame
    Camera.CFrame = CFrame.new(Current.Position) * CFrame.Angles(0, Delta, 0) * (Current - Current.Position)
end

function AutoFish.StartShake()
    if AutoFish.Shaking then return end

    AutoFish.Shaking = true
    AutoFish.ShakeStart = os.clock()
    AutoFish.ShakeOffset = 0

    pcall(function()
        RunService:UnbindFromRenderStep("MeowAutoShake")
    end)

    RunService:BindToRenderStep("MeowAutoShake", Enum.RenderPriority.Camera.Value + 1, AutoFish.ShakeStep)
end

function AutoFish.StopShake()
    if not AutoFish.Shaking then return end

    AutoFish.Shaking = false

    pcall(function()
        RunService:UnbindFromRenderStep("MeowAutoShake")
    end)

    local Camera = Workspace.CurrentCamera

    if Camera and AutoFish.ShakeOffset ~= 0 then
        local Current = Camera.CFrame
        Camera.CFrame = CFrame.new(Current.Position) * CFrame.Angles(0, -AutoFish.ShakeOffset, 0) * (Current - Current.Position)
    end

    AutoFish.ShakeOffset = 0
end

function AutoFish.OnRagdollChanged()
    local Character = LocalPlayer.Character
    if not Character then return end

    local IsRagdolled = Character:GetAttribute("IsRagdolled") == true

    if not (AutoFish.Enabled and IsRagdolled) then
        return
    end

    local Root = Character:FindFirstChild("HumanoidRootPart")
    if not Root then return end

    Root.Anchored = true

    task.delay(1.5, function()
        local CurrentCharacter = LocalPlayer.Character
        if not CurrentCharacter or CurrentCharacter ~= Character then return end

        local CurrentRoot = CurrentCharacter:FindFirstChild("HumanoidRootPart")
        if CurrentRoot then
            CurrentRoot.Anchored = false
        end
    end)
end

function AutoFish.SetupRagdollListener(Character)
    if AutoFish.RagdollConn then
        AutoFish.RagdollConn:Disconnect()
        AutoFish.RagdollConn = nil
    end

    if not Character then return end

    AutoFish.RagdollConn = Character:GetAttributeChangedSignal("IsRagdolled"):Connect(AutoFish.OnRagdollChanged)

    if Character:GetAttribute("IsRagdolled") == true then
        AutoFish.OnRagdollChanged()
    end
end

function AutoFish.Run(RunId)
    while AutoFish.Enabled and RunId == AutoFish.RunId do
        local Now = os.clock()
        local Mashing = LocalPlayer:GetAttribute("IsMashing") == true
        local Shaking = LocalPlayer:GetAttribute("IsShaking") == true
        local Reacting = LocalPlayer:GetAttribute("IsReacting") == true

        AutoFish.FireNearbyPrompts()

        if Mashing and AutoFish.AutoMash and not AutoFish.MashActive then
            AutoFish.MashActive = true
            task.spawn(AutoFish.RunMash, RunId)
        end

        if Shaking and AutoFish.AutoShake then
            AutoFish.StartShake()
        end

        if Reacting and AutoFish.AutoReact and not AutoFish.ReactActive then
            AutoFish.ReactActive = true
            task.spawn(AutoFish.RunReaction, RunId)
        end

        if Mashing or Shaking or Reacting then
            AutoFish.PhaseAt = Now
        else
            local Phase = AutoFish.Phase
            local Rod, Equipped = AutoFish.FindRod()

            if Phase ~= "Idle" and not Equipped then
                AutoFish.Reset()
            elseif Phase == "Idle" then
                if AutoFish.AutoCast
                    and Now - AutoFish.PhaseAt >= AutoFish.RecastDelay
                    and Now - AutoFish.CastAt >= 3 then

                    if not Rod then
                        if Now - AutoFish.NotifyAt > 10 then
                            AutoFish.NotifyAt = Now
                            Utils.Notify("Fishing rod not found.")
                        end
                    elseif not Equipped then
                        AutoFish.EquipRod()
                        AutoFish.CastAt = Now - 2.5
                    else
                        AutoFish.CastAt = Now
                        AutoFish.Click()
                    end
                end
            else
                local Limit = AutoFish.Timeouts[Phase]

                if Limit and Now - AutoFish.PhaseAt > Limit then
                    AutoFish.Click()
                    AutoFish.Reset()
                elseif Phase == "Bite" and AutoFish.AutoReel then
                    AutoFish.Click()
                end
            end
        end

        task.wait(0.05)
    end
end

function AutoFish.SetEnabled(Value)
    if Value then
        if AutoFish.Enabled then return end

        local Remote = AutoFish.GetRemote()

        if not Remote then
            Utils.Notify("FishingEvent remote not found.")

            task.defer(function()
                pcall(function()
                    Meow.Toggles.AutoFishToggle:SetValue(false)
                end)
            end)

            return
        end

        AutoFish.Enabled = true
        AutoFish.RunId += 1
        AutoFish.GetQte()
        AutoFish.Reset()
        AutoFish.PhaseAt = 0
        AutoFish.CastAt = 0

        AutoFish.Listener = Remote.OnClientEvent:Connect(AutoFish.OnEvent)
        AutoFish.CharConn = LocalPlayer.CharacterAdded:Connect(function(Character)
            AutoFish.Reset()
            AutoFish.SetupRagdollListener(Character)
        end)

        AutoFish.SetupRagdollListener(LocalPlayer.Character)

        task.spawn(AutoFish.Run, AutoFish.RunId)
    else
        AutoFish.Enabled = false
        AutoFish.RunId += 1

        if AutoFish.Listener then
            AutoFish.Listener:Disconnect()
            AutoFish.Listener = nil
        end

        if AutoFish.CharConn then
            AutoFish.CharConn:Disconnect()
            AutoFish.CharConn = nil
        end

        if AutoFish.RagdollConn then
            AutoFish.RagdollConn:Disconnect()
            AutoFish.RagdollConn = nil
        end

        AutoFish.StopShake()
        AutoFish.Reset()

        local Character = LocalPlayer.Character
        local Root = Character and Character:FindFirstChild("HumanoidRootPart")
        if Root and Root.Anchored then
            Root.Anchored = false
        end
    end
end

