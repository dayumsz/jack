function Combat.BuildIgnore(Character)
    local List = {}

    local function Add(Object)
        if Object then
            table.insert(List, Object)
        end
    end

    Add(LocalPlayer.Character)
    Add(Character)
    Add(Combat.GetEntity(LocalPlayer))
    Add(Combat.GetHorse(LocalPlayer))

    local Player = Players:GetPlayerFromCharacter(Character)

    if Player then
        Add(Combat.GetEntity(Player))
        Add(Combat.GetHorse(Player))
    end

    return List
end

function Combat.IsVisible(TargetPart, Character)
    local CurrentCamera = Workspace.CurrentCamera

    if not CurrentCamera or not TargetPart or not Character or not TargetPart.Parent then
        return false
    end

    local Origin = CurrentCamera.CFrame.Position
    local Direction = TargetPart.Position - Origin

    if Direction.Magnitude < 0.1 then
        return true
    end

    local Ignore = Combat.BuildIgnore(Character)
    local Params = RaycastParams.new()
    Params.FilterType = Enum.RaycastFilterType.Exclude
    Params.IgnoreWater = true

    for _ = 1, 8 do
        Params.FilterDescendantsInstances = Ignore

        local Result = Workspace:Raycast(Origin, Direction, Params)

        if not Result then
            return true
        end

        local Hit = Result.Instance

        if Hit.CanCollide and Hit.Transparency < 0.95 then
            return false
        end

        table.insert(Ignore, Hit)
    end

    return false
end

function Combat.GetAimPart(Character)
    return Character:FindFirstChild("Head")
        or Character:FindFirstChild("UpperTorso")
        or Character:FindFirstChild("Torso")
        or Character:FindFirstChild("HumanoidRootPart")
        or Character.PrimaryPart
end

function Combat.Measure(CurrentCamera, Part)
    local Screen, OnScreen = CurrentCamera:WorldToViewportPoint(Part.Position)

    if not OnScreen or Screen.Z <= 0 then
        return nil
    end

    local Center = CurrentCamera.ViewportSize / 2
    return (Vector2.new(Screen.X, Screen.Y) - Center).Magnitude, Screen
end

function Combat.IsMob(Character)
    if not Combat.MobTarget or not Character then
        return false
    end

    if not Combat.MobNames[Character.Name] then
        return false
    end

    return Players:GetPlayerFromCharacter(Character) == nil
end

function Combat.GetMobs(Now)
    if Now - Combat.MobCacheAt < 0.5 then
        return Combat.MobCache
    end

    Combat.MobCacheAt = Now

    local List = {}
    local Names = Combat.MobNames
    local Entities = Workspace:FindFirstChild("Entities")

    if Entities then
        for _, Mob in ipairs(Entities:GetChildren()) do
            if Names[Mob.Name] and Mob:IsA("Model") then
                table.insert(List, Mob)
            end
        end
    end

    for _, Mob in ipairs(Workspace:GetChildren()) do
        if Names[Mob.Name] and Mob:IsA("Model") then
            table.insert(List, Mob)
        end
    end

    Combat.MobCache = List
    return List
end

function Combat.IsAliveTarget(Part)
    if not Part or not Part.Parent then return false end

    local Character = Part.Parent
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")

    if Humanoid and Humanoid.Health <= 0 then return false end

    local Player = Players:GetPlayerFromCharacter(Character)

    if Player then
        if Player == LocalPlayer or not Humanoid then return false end

        if Combat.FriendCheck and LocalPlayer:IsFriendsWith(Player.UserId) then
            return false
        end
    elseif not Combat.IsMob(Character) then
        return false
    end

    local MyRoot = Utils.GetRoot()

    if MyRoot and (MyRoot.Position - Part.Position).Magnitude > Combat.MaxDistance then
        return false
    end

    return true
end

function Combat.FindTarget(CurrentCamera, Now)
    local Best = nil
    local BestDistance = Combat.FOV

    local function Consider(Character)
        if not Character or not Character.Parent then return end

        local Part = Combat.GetAimPart(Character)

        if not Part then return end

        local Distance = Combat.Measure(CurrentCamera, Part)

        if not Distance or Distance >= BestDistance then return end
        if not Combat.IsAliveTarget(Part) then return end
        if not Combat.IsVisible(Part, Character) then return end

        BestDistance = Distance
        Best = Part
    end

    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            Consider(Player.Character)
        end
    end

    if Combat.MobTarget then
        for _, Mob in ipairs(Combat.GetMobs(Now)) do
            Consider(Mob)
        end
    end

    return Best
end

function Combat.GetTarget(CurrentCamera, Now)
    local Current = Combat.Target

    if Combat.Sticky and Current and Combat.IsAliveTarget(Current) then
        return Current
    end

    if Now - Combat.LastFind >= Combat.FindRate then
        Combat.LastFind = Now
        Combat.Target = Combat.FindTarget(CurrentCamera, Now)
    elseif Current and not Combat.IsAliveTarget(Current) then
        Combat.Target = nil
    end

    return Combat.Target
end

function Combat.GetAimPosition(Target, DeltaTime)
    local Raw = Target.AssemblyLinearVelocity

    if Combat.VelocityTarget ~= Target then
        Combat.VelocityTarget = Target
        Combat.Velocity = Raw
    else
        local Alpha = 1 - math.exp(-12 * math.min(DeltaTime, 0.1))
        Combat.Velocity = Combat.Velocity:Lerp(Raw, Alpha)
    end

    local Speed = Combat.Velocity.Magnitude
    local Boost = 1 + math.clamp(Speed / Combat.ReferenceSpeed, 0, 2) * Combat.SpeedBoost

    return Target.Position + Combat.Velocity * Combat.Prediction * Boost
end

function Combat.Update(DeltaTime)
    local CurrentCamera = Workspace.CurrentCamera

    if not Combat.Enabled or not CurrentCamera then
        Combat.Target = nil
        Combat.VelocityTarget = nil

        if Combat.Circle then
            Combat.Circle.Visible = false
        end

        return
    end

    Combat.UpdateFOV(CurrentCamera)

    local Now = os.clock()
    local Target = Combat.GetTarget(CurrentCamera, Now)

    if not Target then
        Combat.VelocityTarget = nil
        return
    end

    local AimPosition = Combat.GetAimPosition(Target, DeltaTime)
    local Screen, OnScreen = CurrentCamera:WorldToViewportPoint(AimPosition)
    local Center = CurrentCamera.ViewportSize / 2
    local Distance = (Vector2.new(Screen.X, Screen.Y) - Center).Magnitude

    if Screen.Z <= 0 and not Combat.Sticky then return end

    if Distance > Combat.Deadzone then
        local Alpha = Combat.Sticky and 1 or 1 - (1 - Combat.Smooth) ^ (math.min(DeltaTime, 0.1) * 60)
        local Goal = CFrame.lookAt(CurrentCamera.CFrame.Position, AimPosition)
        CurrentCamera.CFrame = CurrentCamera.CFrame:Lerp(Goal, Alpha)
    end

    if OnScreen and Screen.Z > 0 and Distance <= Combat.FireRadius then
        if Now - Combat.FireVisibleAt >= 0.05 then
            Combat.FireVisibleAt = Now
            Combat.FireVisible = Combat.IsVisible(Target, Target.Parent)
        end

        if Combat.FireVisible then
            Combat.Click()
        end
    end
end

function Combat.Bind()
    pcall(function()
        RunService:UnbindFromRenderStep("MeowAimbot")
    end)

    RunService:BindToRenderStep("MeowAimbot", Enum.RenderPriority.Camera.Value + 1, Combat.Update)
end

function Combat.Unbind()
    pcall(function()
        RunService:UnbindFromRenderStep("MeowAimbot")
    end)
end

function Combat.SetEnabled(Value)
    Combat.Enabled = Value
    Combat.Target = nil
    Combat.VelocityTarget = nil

    if Value then
        Combat.CreateFOV()
        Combat.Bind()
    else
        Combat.Unbind()

        if Combat.Circle then
            Combat.Circle.Visible = false
        end
    end
end

