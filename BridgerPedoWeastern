function Utils.GetRoot()
    local Character = LocalPlayer.Character
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

function Utils.NewText(Color)
    local Success, Object = pcall(function()
        local Text = Drawing.new("Text")
        Text.Size = 15
        Text.Center = true
        Text.Outline = true
        Text.Color = Color
        Text.Visible = false

        pcall(function()
            Text.Font = 3
        end)

        return Text
    end)

    return Success and Object or nil
end

function Utils.NewSquare(Color)
    local Success, Object = pcall(function()
        local Square = Drawing.new("Square")
        Square.Filled = true
        Square.Thickness = 1
        Square.Transparency = 1
        Square.Color = Color
        Square.Visible = false
        return Square
    end)

    return Success and Object or nil
end

function Utils.NewBox(Color, Thickness, ZIndex)
    local Success, Object = pcall(function()
        local Square = Drawing.new("Square")
        Square.Filled = false
        Square.Thickness = Thickness
        Square.Transparency = 1
        Square.Color = Color
        Square.ZIndex = ZIndex
        Square.Visible = false
        return Square
    end)

    return Success and Object or nil
end

function Utils.Remove(Object)
    if Object then
        pcall(function()
            Object:Remove()
        end)
    end
end

function Utils.AcquireText(Color)
    local Object = table.remove(Utils.TextPool)

    if Object then
        Object.Color = Color
        return Object
    end

    return Utils.NewText(Color)
end

function Utils.ReleaseText(Object)
    Object.Visible = false

    if #Utils.TextPool >= Utils.PoolLimit then
        Utils.Remove(Object)
    else
        table.insert(Utils.TextPool, Object)
    end
end

function Utils.AcquireSquare(Color)
    local Object = table.remove(Utils.SquarePool)

    if Object then
        Object.Color = Color
        return Object
    end

    return Utils.NewSquare(Color)
end

function Utils.ReleaseSquare(Object)
    Object.Visible = false

    if #Utils.SquarePool >= Utils.PoolLimit * 2 then
        Utils.Remove(Object)
    else
        table.insert(Utils.SquarePool, Object)
    end
end

function Utils.ClearPools()
    for _, Object in ipairs(Utils.TextPool) do
        Utils.Remove(Object)
    end

    for _, Object in ipairs(Utils.SquarePool) do
        Utils.Remove(Object)
    end

    table.clear(Utils.TextPool)
    table.clear(Utils.SquarePool)
end

function Utils.Connect(Holder, Signal, Callback)
    if not Holder.Connection then
        Holder.Connection = Signal:Connect(Callback)
    end
end

function Utils.Disconnect(Holder)
    if Holder.Connection then
        Holder.Connection:Disconnect()
        Holder.Connection = nil
    end
end

function Utils.IsTarget(Instance)
    return Instance:IsA("Model") or Instance:IsA("BasePart")
end

function Utils.GetPosition(Target)
    if Target:IsA("BasePart") then
        return Target.Position
